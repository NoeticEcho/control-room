{
  "name": "<name>",
  "run_once_at": "<run-once-at>",
  "persist_session": true,
  "job_config": {
    "ccr": {
      "environment_id": "<environment-id>",
      "session_context": {
        "model": "<model>",
        "sources": [
          {
            "type": "git_repository",
            "url": "<repository-url>"
          }
        ],
        "allowed_tools": [
          "Bash",
          "Read",
          "Edit",
          "Write",
          "Glob",
          "Grep"
        ]
      },
      "events": [
        {
          "type": "user",
          "uuid": "<event-uuid>",
          "message": {
            "role": "user",
            "content": "<message>"
          }
        }
      ]
    }
  }
}
