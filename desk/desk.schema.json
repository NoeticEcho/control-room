{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/NoeticEcho/control-room/desk/desk.schema.json",
  "title": "control-room desk",
  "description": "The decision desk (docs/desk.md): one queue of cards, each holding only what the owner can do. The coordinator is the only writer of this file; the owner answers in desk/index.html, which gives the answer back as a JSON snippet for the coordinator to apply.",
  "type": "object",
  "required": ["cards"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "When the coordinator last wrote the queue."
    },
    "cards": {
      "type": "array",
      "items": {"$ref": "#/definitions/card"}
    }
  },
  "definitions": {
    "card": {
      "type": "object",
      "required": ["id", "kind", "title", "why", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable id, used in the answer snippet."
        },
        "kind": {
          "type": "string",
          "enum": ["decision", "action"],
          "description": "`decision`: the owner chooses. `action`: the owner does something the agents have no right to do."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "The action or the question, in the owner's language."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "description": "What waits on it."
        },
        "context": {
          "type": "string",
          "description": "What the owner needs to know, and nothing more."
        },
        "steps": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "In order. Nothing the owner has to guess."
        },
        "texts": {
          "type": "array",
          "description": "Every script, message or config to paste, whole, each shown with a copy button.",
          "items": {
            "type": "object",
            "required": ["label", "text"],
            "additionalProperties": false,
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1}
            }
          }
        },
        "choices": {
          "type": "array",
          "description": "For a decision: the options, with the recommended one marked.",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "label": {"type": "string", "minLength": 1},
              "consequence": {"type": "string", "description": "What happens if the owner picks it."},
              "recommended": {"type": "boolean"}
            }
          }
        },
        "links": {
          "type": "array",
          "description": "Where to look.",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "url": {"type": "string", "pattern": "^(https?://|mailto:)"}
            }
          }
        },
        "answer": {
          "type": "object",
          "description": "Written by the owner (through the coordinator, who applies the snippet the page gives).",
          "required": ["at"],
          "additionalProperties": false,
          "properties": {
            "choice": {"type": "string"},
            "note": {"type": "string"},
            "at": {"type": "string", "format": "date-time"}
          }
        },
        "status": {
          "type": "string",
          "enum": ["open", "answered", "done"],
          "description": "`open` → `answered` (the owner replied) → `done` (the coordinator acted, and says what it did in `resolution`)."
        },
        "resolution": {
          "type": "string",
          "description": "For `done`: what the coordinator did with the answer."
        },
        "created": {"type": "string", "format": "date-time"},
        "source": {
          "type": "string",
          "description": "Where the card came from: an epic's handoff question, a task assigned to the owner."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["answered", "done"]}}},
          "then": {"required": ["answer"]}
        },
        {
          "if": {"properties": {"status": {"const": "done"}}},
          "then": {"required": ["resolution"]}
        }
      ]
    }
  }
}
