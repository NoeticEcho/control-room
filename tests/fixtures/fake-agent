#!/bin/sh
# A stand-in for an agent CLI. Appends one JSON line per call to
# $FAKE_AGENT_LOG: the arguments, the working directory and the profile
# variable ($FAKE_AGENT_VAR, default CR_PROFILE). Prints a reply
# ($FAKE_AGENT_STDOUT when set; errors from $FAKE_AGENT_STDERR on stderr), and
# exits with $FAKE_AGENT_EXIT (default 0).
var=${FAKE_AGENT_VAR:-CR_PROFILE}
profile=$(printenv "$var" || true)
jq -cn --arg cwd "$(pwd)" --arg profile "$profile" \
	'{args: $ARGS.positional, cwd: $cwd, profile: $profile}' --args -- "$@" \
	>>"${FAKE_AGENT_LOG:?}"
if [ -n "${FAKE_AGENT_STDOUT+set}" ]; then
	printf '%s\n' "$FAKE_AGENT_STDOUT"
else
	echo "fake agent: $# arguments"
fi
[ -z "${FAKE_AGENT_STDERR:-}" ] || printf '%s\n' "$FAKE_AGENT_STDERR" >&2
exit "${FAKE_AGENT_EXIT:-0}"
