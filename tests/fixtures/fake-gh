#!/bin/sh
# A stand-in for the GitHub CLI. Appends its arguments as one JSON line to
# $FAKE_GH_LOG. For `issue list ... --label <l>` it prints
# $FAKE_GH_DIR/<l>.json (or [] when there is none). Exits $FAKE_GH_EXIT, or 1
# for an `issue list` whose label is $FAKE_GH_FAIL_LABEL. For `pr list` it
# prints $FAKE_GH_DIR/prs.json (or []).
jq -cn '$ARGS.positional' --args -- "$@" >>"${FAKE_GH_LOG:?}"
[ "${FAKE_GH_EXIT:-0}" -eq 0 ] || exit "$FAKE_GH_EXIT"
if [ "${1-}" = issue ] && [ "${2-}" = list ]; then
	label=
	while [ $# -gt 0 ]; do
		[ "$1" = --label ] && label=${2-}
		shift
	done
	[ "$label" != "${FAKE_GH_FAIL_LABEL:-}" ] || exit 1
	if [ -f "${FAKE_GH_DIR:?}/$label.json" ]; then cat "$FAKE_GH_DIR/$label.json"; else echo '[]'; fi
fi
if [ "${1-}" = pr ] && [ "${2-}" = list ]; then
	if [ -f "${FAKE_GH_DIR:?}/prs.json" ]; then cat "$FAKE_GH_DIR/prs.json"; else echo '[]'; fi
fi
